# StudySimplify environment variables — placeholders only. Never commit real values.
# Copy to .env.local for local development. Configure separate values for
# Development, Preview and Production in Vercel.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | preview | production. Only "production" is indexed by search engines
# and only "production" forbids the development payment provider.
NEXT_PUBLIC_APP_ENV=development
APP_ENV=development
CONTACT_EMAIL=

# --- Supabase (leave empty to run in read-only demo mode) -----------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Payments -------------------------------------------------------------
# none | dev | stripe | razorpay
#   dev = local simulator, refuses to run when APP_ENV=production
PAYMENT_PROVIDER=none

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Random string used to sign simulated webhooks when PAYMENT_PROVIDER=dev
DEV_PAYMENTS_SECRET=

# Recurring billing (Stripe only). Leave false until plans are configured and tested.
SUBSCRIPTIONS_ENABLED=false

# --- Email ----------------------------------------------------------------
# none | resend. With "none", emails are logged as skipped, never reported as sent.
EMAIL_PROVIDER=none
RESEND_API_KEY=
# e.g. "StudySimplify <receipts@your-domain.com>" (domain must be verified with the provider)
EMAIL_FROM=

# --- PDFs -----------------------------------------------------------------
# true = stream paid PDFs with a masked buyer licence line instead of a signed redirect
PDF_WATERMARK=false

# --- Tests ----------------------------------------------------------------
# Plain PostgreSQL used by `npm run test:db` (a throwaway database is created per run)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
